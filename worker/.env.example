# Sama dengan nilai di aplikasi web (Vercel).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Harus SAMA persis dengan OTP_ENCRYPTION_KEY di web.
# Jika kosong di web, turunannya adalah `${SESSION_SECRET}:otp`.
OTP_ENCRYPTION_KEY=ganti-dengan-kunci-rahasia-yang-sama

# Template pesan OTP. Placeholder: {{kode}}, {{menit}}, {{kode_otp}}
OTP_TEMPLATE="Kode verifikasi Ta'awun Maqom Kuttab Al Fatih Lampung: {{kode}}. Berlaku {{menit}} menit. Jangan bagikan kode ini kepada siapa pun."
OTP_EXPIRY_MINUTES=10

# Folder penyimpanan sesi WhatsApp Baileys (jangan di-commit).
AUTH_DIR=./auth_info

# Interval heartbeat dan polling OTP (milidetik).
HEARTBEAT_INTERVAL_MS=30000
OTP_POLL_INTERVAL_MS=3000

# Level log: silent, error, warn, info
LOG_LEVEL=info

# ============================================================
# Ta'awun Maqom Kuttab Al Fatih Lampung — contoh environment
# Salin file ini menjadi .env.local lalu isi nilainya.
# ============================================================

# Mode demo: true = memakai data lokal (tanpa Supabase).
# Biarkan kosong/false jika Supabase sudah dikonfigurasi.
DEMO_MODE=false

# URL publik aplikasi (tanpa garis miring di akhir).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Keamanan ----------
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
OTP_ENCRYPTION_KEY=

# Batas ukuran bukti transfer (byte). Default 3 MB.
UPLOAD_MAX_BYTES=3145728

# ---------- Akun admin demo (hanya dipakai saat DEMO_MODE=true) ----------
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=Taawun123!

# ============================================================
# Worker WhatsApp (Baileys) — isi di environment worker,
# bukan di aplikasi Next.js.
# ============================================================
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# OTP_ENCRYPTION_KEY=   (harus sama persis dengan nilai di atas)
# AUTH_DIR=./auth_info
# OTP_TEMPLATE=...
# Lihat worker/.env.example untuk daftar lengkap.
